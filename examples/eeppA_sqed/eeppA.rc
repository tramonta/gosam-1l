process_name=eeppA
process_path=virtual
# PDG codes for e-, e+; model names for the charged scalars
in=11,-11
out=phip,phim,A
# powers of the coupling in the amplitude: e^2 at LO, e^4 at one loop
order=gw,3,5
# by name: the model is installed with GoSam (share/golem/models);
# the name sqed_ct also switches on its counterterms
model=sqed_ct
# no self-energies on external legs (their effect is in the counterterm
# vertices) and no tadpoles
qgraf.options=onshell,notadpole
# keep all masses: the default zero= would make e and mu massless
zero=
# keep e: the default one= is empty already, written here for clarity
one=
reduction_programs=ninja,golem95
